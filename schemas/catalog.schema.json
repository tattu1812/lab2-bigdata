{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab2-bigdata.local/schemas/catalog.schema.json",
  "title": "Task 4 Data Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "run_id", "datasets", "artifacts"],
  "properties": {
    "catalog_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/dataset"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "dataset_id",
        "title",
        "purpose",
        "owner",
        "steward",
        "classification",
        "allowed_use",
        "location",
        "schema_version",
        "columns",
        "as_of",
        "row_count",
        "input_manifest_sha256",
        "contract_sha256",
        "code_sha256",
        "quality_report",
        "retention",
        "provenance"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "steward": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "allowed_use": {"type": "string", "minLength": 1},
        "location": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uri"],
            "properties": {
              "uri": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "schema_version": {"type": "string", "minLength": 1},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "meaning", "unit", "nullable"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 1},
              "unit": {"type": ["string", "null"]},
              "nullable": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "as_of": {
          "type": "string",
          "const": "2026-02-09T00:00:00Z"
        },
        "row_count": {"type": "integer", "minimum": 0},
        "input_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quality_report": {"type": "string", "minLength": 1},
        "retention": {
          "type": "object",
          "required": [
            "days",
            "start_basis",
            "hold",
            "dependency_policy",
            "dependent_release_ids",
            "action"
          ],
          "properties": {
            "days": {"type": ["integer", "null"], "minimum": 0},
            "start_basis": {"type": "string", "minLength": 1},
            "hold": {"type": "boolean"},
            "dependency_policy": {"type": "string", "minLength": 1},
            "dependent_release_ids": {
              "type": "array",
              "items": {"type": "string"}
            },
            "action": {"type": "string", "minLength": 1}
          }
        },
        "provenance": {
          "type": "object",
          "required": ["job_name", "run_id", "role"],
          "properties": {
            "job_name": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "location",
        "row_count",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "row_count": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
